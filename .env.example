# CampusVoice Environment Variables

# App Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusvoice?schema=public"
# Restricted database role for vault schema (optional in dev, required in production)
VAULT_DATABASE_URL="postgresql://vault_user:vault_pass@localhost:5432/campusvoice?schema=vault"

# Supabase Credentials (if using Supabase directly)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cryptography & Security
# 32-byte base64 string for AES-256-GCM vault encryption
VAULT_KEY="base64-encoded-32-byte-secret-key-here="
# Secret pepper for hashing tracking keys before storing
TRACKING_KEY_PEPPER="super-secret-pepper-string-campusvoice"
# Secret for signing JWT / authentication sessions
JWT_SECRET="super-secret-jwt-signing-key-campusvoice-2026"

# Google Gemini API (AI Provider)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"
GEMINI_EMBED_MODEL="gemini-embedding-001"
AI_MODEL_CHAT="gemini-flash-latest"
AI_MODEL_ANALYSIS="gemini-flash-latest"
AI_EMBED_MODEL="gemini-embedding-001"
AI_DAILY_COST_CAP="10.00"

# Email Configuration (SMTP / Active Ethereal Auto-Dispatch)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="noreply@campusvoice.local"
DISPATCH_ALERT_EMAIL="intake@campusvoice.local"

# SMS Dispatcher (Twilio / Mock)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_PHONE="+1xxxxxxxxxx"

# Emergency & Security Contacts
SECURITY_CONTACT_EMAILS="security@campus.edu,chief.security@campus.edu"
SECURITY_CONTACT_PHONES="+919876543210,+919876543211"

# Storage (S3-compatible / Cloudflare R2 / Supabase Storage)
S3_ENDPOINT=""
S3_BUCKET="campusvoice-evidence"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
